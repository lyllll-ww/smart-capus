{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixPackages": ["nodejs_20"]
        },
        "install": {
          "commands": ["npm install"]
        },
        "build": {
          "commands": []
        },
        "start": {
          "commands": ["npm start"]
        }
      }
    }
  },
  "deploy": {
    "numReplicas": 1,
    "sleepApplication": false,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
